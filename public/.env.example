# Copy this file to .env and fill it in. Never commit .env.

# Port the server listens on (default 3000)
PORT=3000

# A long random text. Used to sign the login cookie.
# Make one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me

# PostgreSQL for accounts. Leave empty to use data/users.json (local testing).
# Example: postgres://gomoku:PASSWORD@localhost:5432/gomoku
DATABASE_URL=

# Optional: where users.json lives when DATABASE_URL is empty (default ./data)
# DATA_DIR=./data
